{
  "build": {
    "type": "nextjs"
  },
  "env": {
    "TRADINGVIEW_SESSION": "${TRADINGVIEW_SESSION}",
    "TRADINGVIEW_SIGNATURE": "${TRADINGVIEW_SIGNATURE}",
    "CRON_SECRET": "${CRON_SECRET}",
    "WATCHLIST": "${WATCHLIST}",
    "ZEABUR_URL": "${ZEABUR_URL}",
    "DISCORD_WEBHOOK_URL": "${DISCORD_WEBHOOK_URL}",
    "NEXT_PUBLIC_SUPABASE_URL": "${NEXT_PUBLIC_SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
    "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
    "TELEGRAM_CHAT_ID": "${TELEGRAM_CHAT_ID}"
  },
  "cron": [
    {
      "schedule": "30 12 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "US pre-market: 20:30 Taiwan (12:30 UTC) weekdays"
    },
    {
      "schedule": "0 0 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "TW pre-market: 08:00 Taiwan (00:00 UTC) weekdays"
    },
    {
      "schedule": "30 13 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "Asia close scan: 21:30 Taiwan (13:30 UTC) weekdays, captures TWSE/HKEX close"
    }
  ],
  "health_check": {
    "path": "/api/cron/health"
  }
}
