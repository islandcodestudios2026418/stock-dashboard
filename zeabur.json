{
  "build": {
    "type": "nextjs"
  },
  "env": {
    "TRADINGVIEW_SESSION": "${TRADINGVIEW_SESSION}",
    "TRADINGVIEW_SIGNATURE": "${TRADINGVIEW_SIGNATURE}",
    "CRON_SECRET": "${CRON_SECRET}",
    "WATCHLIST": "${WATCHLIST}",
    "ZEABUR_URL": "${ZEABUR_URL}",
    "DISCORD_WEBHOOK_URL": "${DISCORD_WEBHOOK_URL}",
    "NEXT_PUBLIC_SUPABASE_URL": "${NEXT_PUBLIC_SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
    "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
    "TELEGRAM_CHAT_ID": "${TELEGRAM_CHAT_ID}",
    "FINNHUB_API_KEY": "${FINNHUB_API_KEY}",
    "IBKR_GATEWAY_URL": "${IBKR_GATEWAY_URL}",
    "IBKR_ACCOUNT_ID": "${IBKR_ACCOUNT_ID}",
    "IBKR_LIVE": "${IBKR_LIVE}",
    "IBKR_AUTO_EXECUTE": "${IBKR_AUTO_EXECUTE}"
  },
  "cron": [
    {
      "schedule": "30 12 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "US pre-market: 20:30 Taiwan (12:30 UTC) weekdays"
    },
    {
      "schedule": "0 0 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "TW pre-market: 08:00 Taiwan (00:00 UTC) weekdays"
    },
    {
      "schedule": "30 13 * * 1-5",
      "path": "/api/cron/trigger?secret=${CRON_SECRET}",
      "comment": "Asia close scan: 21:30 Taiwan (13:30 UTC) weekdays, captures TWSE/HKEX close"
    },
    {
      "schedule": "*/5 13-19 * * 1-5",
      "path": "/api/cron/monitor?secret=${CRON_SECRET}",
      "comment": "Position monitor: every 5min during US market hours (13:30-20:00 UTC)"
    },
    {
      "schedule": "0 20 * * 0",
      "path": "/api/cron/weekly-report?secret=${CRON_SECRET}",
      "comment": "Weekly report: Sunday 04:00 Taiwan (20:00 UTC Saturday)"
    },
    {
      "schedule": "30 20 * * 0",
      "path": "/api/cron/watchlist-rotation?secret=${CRON_SECRET}",
      "comment": "Watchlist rotation: Sunday 04:30 Taiwan (20:30 UTC Saturday)"
    },
    {
      "schedule": "0 21 * * 0",
      "path": "/api/cron/sndk-scanner?secret=${CRON_SECRET}",
      "comment": "SNDK scanner: Sunday 05:00 Taiwan (21:00 UTC) - scan universe for new candidates"
    }
  ],
  "health_check": {
    "path": "/api/cron/health"
  }
}
